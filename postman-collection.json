                    "exec": [
                      "console.log('Step 3 - Echo response:', pm.response.json());"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/message/echo?sessionId={{sessionId}}",
                  "host": ["{{baseUrl}}"],
